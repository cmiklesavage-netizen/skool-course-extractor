# Copy this file to .env and fill in your own values
# NEVER commit .env to git or share it publicly

# Skool login credentials
SKOOL_EMAIL=your_email@example.com
SKOOL_PASSWORD=your_skool_password
SKOOL_COMMUNITY_URL=https://www.skool.com/your-community-slug

# OpenRouter API key — get one free at https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Browse available models at: https://openrouter.ai/models
OPENROUTER_MODEL=anthropic/claude-opus-4-5

# Whisper transcription model size (tiny, base, small, medium, large)
# "base" is a good balance of speed and accuracy
WHISPER_MODEL=base

# Leave these blank — not used by this project
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
